# Sentire Books — backup job configuration (M1.1)
#
# Copy to backup.env on the host that runs the schedule, fill in, and
# `chmod 600` it. This file holds a database password and storage credentials —
# it must never be committed.

# ── Database ──────────────────────────────────────────────────────────────────
# MUST be the OWNER connection (the same one as DATABASE_URL_DIRECT), NOT the
# API's `sentire_books_app` role. Every tenant table is under Row-Level
# Security: as the app role, pg_dump fails AND leaves an empty archive behind.
# backup.sh refuses to run unless the role can bypass RLS.
BACKUP_DATABASE_URL="postgres://OWNER:PASSWORD@DB_HOST:5432/sentire_books"

# ── Destination ───────────────────────────────────────────────────────────────
# Either an S3-compatible bucket (needs the `aws` CLI on the host) …
BACKUP_DEST="s3://sentire-books-backups/postgres"
# … or an absolute path on a volume that is NOT the database host's own disk:
# BACKUP_DEST="/mnt/offhost-backups/sentire-books"

# S3-compatible credentials (Backblaze B2, Cloudflare R2, Wasabi, AWS …).
# Use a key scoped to this bucket with write+list only — not an account root key.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="ap-southeast-1"
# Non-AWS S3-compatible providers need their endpoint:
# AWS_ENDPOINT_URL="https://s3.us-west-000.backblazeb2.com"

# ── Retention & staging ───────────────────────────────────────────────────────
# Local staging copies older than this are removed. Remote retention is the
# bucket's lifecycle policy (see docs/ops/backups.md).
BACKUP_RETENTION_DAYS="30"
BACKUP_STAGING="/var/tmp/sentire-books-backups"

# A table that must never legitimately be empty. The script extracts it from the
# finished archive and fails if it has zero rows, so an empty backup can never
# be published. `accounts` always holds at least the 158-account default chart.
BACKUP_CANARY_TABLE="accounts"
